# ============ 模型配置（全部可选；默认 mock 离线模式，无需配置即可运行）============
# mock = 离线确定性决策器（只验证流程，不证明真实模型决策效果）
# real = 真实 LLM（OpenAI 兼容 /chat/completions 接口，已在 DeepSeek 上验证）
MODEL_MODE=mock

# 仅 real 模式需要：
MODEL_BASE_URL=https://api.deepseek.com
MODEL_NAME=deepseek-chat
MODEL_API_KEY_ENV=DEEPSEEK_API_KEY
MODEL_TEMPERATURE=0

# 真实密钥请放入 .env（已被 .gitignore 排除），不要把密钥提交到仓库
